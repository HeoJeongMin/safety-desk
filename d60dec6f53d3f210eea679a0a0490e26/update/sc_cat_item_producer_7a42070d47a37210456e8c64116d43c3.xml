        <script><![CDATA[
var grTop = new GlideRecord('x_1903597_safety_0_u_top_category');
if (grTop.get('name', producer.u_top_category)) { 
    current.u_top_category = grTop.getUniqueValue(); 
}

var grDomain = new GlideRecord('x_1903597_safety_0_u_domain');
if (grDomain.get('name', producer.u_domain)) { 
    current.u_domain = grDomain.getUniqueValue();
}

var topCode = "";
    var subCode = "";

    // 1. Top Category 코드 조회
    var topCat = new GlideRecord('x_1903597_safety_0_u_top_category');
    topCat.addQuery('name', producer.u_top_category); 
    topCat.query();
    if (topCat.next()) {
        topCode = topCat.getValue('code');
    }

    // 2. Sub Domain 코드 조회
    var subDom = new GlideRecord('x_1903597_safety_0_u_sub_domain');
    subDom.addQuery('description', producer.u_sub_domain); 
    subDom.query();
    if (subDom.next()) {
        subCode = subDom.getValue('code');
    }

    // 3. 최종 코드 조합 및 배정 로직 실행
    if (topCode && subCode) {
        var finalInquiryCode = topCode + "-" + subCode;
        current.u_inquiry_code = finalInquiryCode;

        // --- 추가된 배정 로직 ---
        var assignTable = new GlideRecord('x_1903597_safety_0_u_inquiry_assignment');
        assignTable.addQuery('inquiry_code', finalInquiryCode); // 매트릭스 테이블의 코드 필드명 확인
        assignTable.query();

        if (assignTable.next()) {
            // 조회된 담당자와 그룹을 현재 Inquiry 레코드에 할당
            current.assigned_to = assignTable.getValue('assigned_to');
            current.assignment_group = assignTable.getValue('assignment_group');
        }
    }]]></script>
